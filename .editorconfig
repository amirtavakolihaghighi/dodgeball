# Shared editor settings (https://editorconfig.org): most editors apply them automatically.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[static/vendor/**]
# Third-party files, kept exactly as published.
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
