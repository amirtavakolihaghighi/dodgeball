# Local Python environments (machine-specific, never share them)
.venv/
__pycache__/
*.pyc

# Build output: rebuild with build_exe.bat; releases carry the zip
build/
dist/

# Screenshots and other output from the browser tests
/*.png
tests/browser/*.png
tests/browser/out/

# Made at runtime, per machine: the host's saved rules, the session logs, and the moves file's
# earlier versions (each save from the moves page keeps the file it replaces)
saved_rules.json
logs/
move_saves/

# Written by build_exe.py during a build
build_info.json

# Session logs collected from play sessions: players' names and LAN addresses
/testlog/

# Blender output: renders and .blend files, rebuilt by the scripts in art/
art/out/

# Editors and operating systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
