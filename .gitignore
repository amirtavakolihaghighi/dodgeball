# Local Python environments (machine-specific, never share them)
.venv/
__pycache__/
*.pyc

# Build output: rebuild with build_exe.bat; releases carry the zip
build/
dist/

# Screenshots and other output from the browser tests
/*.png
tests/browser/*.png
tests/browser/out/

# Made at runtime, per machine: the host's saved rules and the session logs
saved_rules.json
logs/

# Written by build_exe.py during a build
build_info.json

# Session logs collected from play sessions: players' names and LAN addresses
/testlog/

# Editors and operating systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
