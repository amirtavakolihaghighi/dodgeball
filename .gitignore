# Local Python environments (machine-specific, never share them)
.venv/
__pycache__/
*.pyc

# Build output: rebuild with prototype\build_exe.bat; releases carry the zip
build/
dist/

# Screenshots and other output from the browser tests
prototype/*.png
prototype/tests/browser/*.png
prototype/tests/browser/out/

# Made at runtime, per machine: the host's saved rules and the session logs
saved_rules.json
logs/

# Written by build_exe.py during a build
build_info.json

# Session logs the user collects from office tests: coworkers' names and IP addresses
prototype/testlog/
