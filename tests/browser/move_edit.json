[
  {"waitFor": "window.moveView && window.moveView.ready", "timeout": 30000},
  {"evalFile": "move_view.js"},
  {"eval": "__mvEditFind()"},
  {"eval": "__mvEdit()"},
  {"eval": "moveView.select('D2', 0, false); moveView.edit.open(); moveView.edit.choose('hand', 1); 'the editor on the parry'"},
  {"wait": 600},
  {"shot": "move_edit_parry.png"},
  {"eval": "moveView.select('E2', 0, false); moveView.edit.choose('lead', 2); 'the editor on the dash right'"},
  {"wait": 600},
  {"shot": "move_edit_dash.png"},
  {"eval": "moveView.edit.close(); __mvEditSave()"},
  {"eval": "__mvEditMouseSetup()"},
  {"mouse": "move", "at": "__mvMouse.at"},
  {"mouse": "down", "at": "__mvMouse.at"},
  {"mouse": "move", "at": "({ x: __mvMouse.at.x, y: __mvMouse.at.y - 20 })", "buttons": 1},
  {"mouse": "move", "at": "({ x: __mvMouse.at.x, y: __mvMouse.at.y - 40 })", "buttons": 1},
  {"mouse": "up", "at": "({ x: __mvMouse.at.x, y: __mvMouse.at.y - 40 })"},
  {"eval": "__mvEditMouseCheck()"},
  {"mouse": "move", "at": "__mvKeyAt"},
  {"mouse": "down", "at": "__mvKeyAt"},
  {"mouse": "move", "at": "({ x: __mvKeyAt.x + 12, y: __mvKeyAt.y })", "buttons": 1},
  {"mouse": "move", "at": "({ x: __mvKeyAt.x + 24, y: __mvKeyAt.y })", "buttons": 1},
  {"mouse": "up", "at": "({ x: __mvKeyAt.x + 24, y: __mvKeyAt.y })"},
  {"eval": "__mvEditKeyCheck()"},
  {"eval": "__mvErrors()"},
  {"eval": "__mvEditDraft()"},
  {"wait": 2500},
  {"waitFor": "window.moveView && window.moveView.ready", "timeout": 30000},
  {"evalFile": "move_view.js"},
  {"eval": "__mvEditDraftBack()"},
  {"eval": "__mvErrors()"}
]
